	;move.b	#$8,($48d,A5)	*开局赠送8个币
	;move.b	#$8,($49d,A5)	*开局赠送8个币	
_select
	move.b	#$40,($333a,A5)		/开局锁30暴击出场
	move.b	#$40,($34ba,A5)
	move.b	#$40,($363a,A5)
	move.b	#$3,($333b,A5)		/开局色板
	move.b	#$7,($34bb,A5)
	move.b	#$f,($363b,A5)
	add.w	D0,D0
	move.w	D0,($20,A0)
	move.b	($636,A5),($7f8a,A5)
	beq	_go_updown
_backto119c
	moveq	#0,D0
	jsr	$119c
	subq.b	#1,($636,A5)
	bne	_backto119c
_go_updown	
	moveq	#0,D0
	move.b	($2,A0),D0
	add.b	#$16,D0
	btst	#$2,(A5,D0.w)
	bne	_ms3
	btst	#$3,(A5,D0.w)
	bne	_ms4
	cmpi.b	#$5,($635,A5)
	bgt	_ms2
	bra	_ms1
_ms4								
	move.b	#$4,($7f88,A5)	/模式标志位内存置4，模式4,轻量版比赛模式
	clr.b	($4d9,A5)
	clr.b	($7f30,A5)
	rts	
_ms3				
	move.b	#$3,($7f88,A5)	/模式标志位内存置3，模式3：固定关卡、随机血量、随机出兵
	clr.b	($4d9,A5)
	clr.b	($7f30,A5)
	rts	
_ms1
	move.b	#$1,($7f88,A5)	/模式标志位内存置1，模式1：随机场景+随机出兵=7BOSS
	clr.b	($4d9,A5)
	clr.b	($7f30,A5)	
	rts
_ms2
	move.b	#$2,($7f88,A5)	/模式标志位内存置2，模式2：随机关卡、随机出兵、固定血量
	movem.l	D0-D1,-(A7)
	moveq	#0,D1
	move.b	($7f8a,A5),D1
_back_random
	moveq	#0,D0
    	jsr 	$119c           ;进入随机程序
    	add.w	D1,D0
    	andi.w  	#$7,D0      	;限制范围
    	cmpi.b	#$7,($4d9,A5)
	beq	_back_random	
	move.b	D0,($4d9,A5)
	move.b	($4d9,A5),($7f30,A5)
	movem.l	(A7)+,D0-D1
	rts		

	
;--------------------过关--------------------------
	ORG	$abec
	jsr	$181c00
	ORG	$181c00
	clr.l	($7fd0,A5)
	clr.l	($7fd4,A5)
	cmpi.b	#$2,($7f88,A5)	/检测是否模式2
	beq	_sjguan 		/模式2，进入随机关卡	
	andi.b  #$7,($4d9,A5)	/其它模式不随机关卡
	rts	
_sjguan   
    movem.l D0-D6,-(A7)   
    addi.b  #$1,$ffff20    ;表示过关次数，每次加1，放入ffff20，
    cmpi.b  #$7,$ffff20     ;过7次关了，说明是8关
    beq     _7_
    cmpi.b  #$6,$ffff20
    beq     _6_
    cmpi.b  #$5,$ffff20
    beq     _5_
    cmpi.b  #$4,$ffff20
    beq     _4_
    cmpi.b  #$3,$ffff20
    beq     _3_
    cmpi.b  #$2,$ffff20
    beq     _2_
;--------以上都不是，说明是第一次过关-----------------
_1_
    clr.l   D0
    jsr	 $119c           ;进入随机程序
    divu.w  #$7,D0      ；限制范围
    swap    D0          ；此时D0低位为【0,6】
    move.b  $ffff30,D1       
    cmp.b   D0,D1               ;第一次过关不可与初次关卡相同
    beq     _1_
    move.b  D0,$ffff32 
    move.b  D0,($4d9,A5)
    andi.b  #$7,($4d9,A5)
    movem.l (A7)+,D0-D6  
    rts
_2_
    clr.l   D0
    jsr 	$119c           ;进入随机程序
    divu.w  #$7,D0      ；限制范围
    swap    D0          ；此时D0低位为【0,6】        
    move.b  $ffff30,D1       
    cmp.b   D0,D1               ;第一次过关
    beq     _2_
    move.b  $ffff32,D2
    cmp.b   D0,D2
    beq     _2_
    move.b  D0,$ffff34      ;第2次过关
    move.b  D0,($4d9,A5)
    andi.b  #$7,($4d9,A5)
    movem.l (A7)+,D0-D6   
    rts  
